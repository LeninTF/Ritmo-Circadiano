# Copiar a .env (no se versiona). Sin secretos reales.
DATABASE_URL=postgresql://circadiano:circadiano_local@localhost:5432/circadiano
PORT=3000
CORS_ORIGIN=http://localhost:4200
JWT_SECRET=
JWT_EXPIRA=8h
# Swagger en /docs solo si vale 'true' (desarrollo y staging; nunca en produccion)
SWAGGER_HABILITADO=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: cambia el puerto del host si ya tienes un PostgreSQL local en 5432
# (ajusta tambien el puerto de DATABASE_URL)
# POSTGRES_PORT=5432
# Solo desarrollo: usuario administrador del seed. Dejar vacia para omitirlo.
SEED_ADMIN_CORREO=admin@circadiano.local
SEED_ADMIN_CLAVE=
# Solo desarrollo/staging: clave comun de las cuentas de prueba por rol
# (J01, D01, T01-T05; ver docs/credenciales-prueba.md). Vacia = no se crean.
SEED_DEMO_CLAVE=
