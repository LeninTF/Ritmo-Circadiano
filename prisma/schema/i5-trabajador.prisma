// Slice I5 · tablas: registro_sueno, aptitud_presalida (+ campos de confirmacion en turno_laboral)

/// Registro diario de sueno del trabajador (RF11, RF12, ERD06).
/// Sincronizado offline mediante OutboxService con idempotencia por client_id.
///
/// NOTA DE INTEGRACION:
/// La referencia logica es `id_usuario -> usuario(id)`.
/// Dado que el modelo `Usuario` pertenece al slice I1 (i1-plataforma.prisma),
/// y conforme a las reglas de colaboracion que prohiben modificar schemas
/// ajenos (lo que requeriria agregar el campo inverso en el modelo Usuario de I1),
/// se define `idUsuario` como campo escalar UUID con restriccion de unicidad
/// compuesta @@unique([idUsuario, fecha]).
/// La relacion foranea Prisma podra formalizarse cuando I1 exponga la relacion.
model RegistroSueno {
  id               String   @id @default(uuid()) @db.Uuid
  idUsuario        String   @map("id_usuario") @db.Uuid
  fecha            DateTime @db.Date
  horaAcostarse    DateTime @map("hora_acostarse") @db.Timestamptz()
  horaDespertar    DateTime @map("hora_despertar") @db.Timestamptz()
  latenciaMin      Int      @default(0) @map("latencia_min")
  despertares      Int      @default(0) @map("despertares")
  calidadPercibida Int      @map("calidad_percibida")
  fatigaPercibida  Int      @map("fatiga_percibida")
  esDiaLaboral     Boolean  @default(true) @map("es_dia_laboral")
  luzMatutinaMin   Int      @default(0) @map("luz_matutina_min")
  clientId         String   @unique @map("client_id") @db.Uuid
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([idUsuario, fecha])
  @@map("registro_sueno")
}

/// Semaforo RN09 persistido. El color no es un diagnostico ni autoriza la salida.
enum ColorAptitud {
  verde
  ambar
  rojo

  @@map("color_aptitud")
}

/// ERD04: autoevaluacion de aptitud pre-salida (RF12, RN09, RN10).
///
/// NOTA DE INTEGRACION:
/// `id_usuario` referencia de forma logica a `usuario(id)` (slice I1) e
/// `id_turno` a `turno_laboral(id)` (slice I2). No se declaran relaciones
/// Prisma porque exigirian campos inversos en modelos de otros slices.
/// `registro_sueno` sigue el mismo
/// criterio. Las FK se formalizan cuando I1 e I2 expongan esas relaciones.
///
/// `compartido` es independiente del color: el calculo no exige consentimiento
/// y el valor por defecto es false (sin divulgacion automatica, RN10).
/// No se guardan sintomas ni otro detalle clinico: el despachador solo podra
/// leer `color` cuando `compartido = true`.
model AptitudPresalida {
  id            String       @id @default(uuid()) @db.Uuid
  idUsuario     String       @map("id_usuario") @db.Uuid
  idTurno       String       @map("id_turno") @db.Uuid
  fechaHora     DateTime     @map("fecha_hora") @db.Timestamptz()
  horasSueno24h Decimal @map("horas_sueno_24h") @db.Decimal(5, 3)
  somnolencia   Int
  color         ColorAptitud
  compartido    Boolean      @default(false)
  creadoEn      DateTime     @default(now()) @map("creado_en") @db.Timestamptz()

  @@index([idUsuario, fechaHora])
  @@index([idTurno])
  @@map("aptitud_presalida")
}
