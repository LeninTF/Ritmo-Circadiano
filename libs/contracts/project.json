{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/contracts/src",
  "projectType": "library",
  "tags": [
    "scope:contracts"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "libs/contracts/jest.config.cts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/contracts/src --max-warnings=0"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/contracts/tsconfig.lib.json"
        ],
        "parallel": false
      }
    }
  }
}
