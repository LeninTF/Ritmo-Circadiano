{
  "name": "domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domain/src",
  "projectType": "library",
  "tags": [
    "scope:domain"
  ],
  "targets": {
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "libs/domain/jest.config.cts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": [
            "typescript"
          ]
        }
      ],
      "options": {
        "commands": [
          "tsc --noEmit -p libs/domain/tsconfig.lib.json",
          "tsc --noEmit -p libs/domain/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}
