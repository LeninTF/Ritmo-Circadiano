{
  "name": "pwa-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/pwa-e2e/src",
  "implicitDependencies": [
    "pwa",
    "api"
  ],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "playwright test -c apps/pwa-e2e/playwright.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/pwa-e2e/tsconfig.json"
      }
    }
  },
  "tags": [
    "type:e2e"
  ]
}
